JWT_SECRET="your-secret-key-change-in-production"
DATABASE_URL="sqlite+aiosqlite:///chat.db"
SITE_URL="https://blog.chrislabs.net"

# App environment + observability
APP_ENV="development"          # development | production (affects default log format)
LOG_LEVEL="INFO"               # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT="console"           # console (dev) | json (prod, machine-readable)

# Umami analytics (hosted). Tracker is injected only when ENABLED and a website id is set.
UMAMI_ENABLED="true"
UMAMI_SCRIPT_URL="https://latitudem2m-analytics.chrislabs.net/script.js"
UMAMI_WEBSITE_ID="057c4459-7212-4f49-a756-bc631a5c5e94"
